<UserControl
    x:Class="MessageBuilder.Views.CustomCheckBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- カラーパレット（ダークテーマ用：必要に応じてアプリのテーマ色に合わせて変更してください） -->
        <SolidColorBrush x:Key="CheckBox.Normal.Border" Color="#555555" />
        <SolidColorBrush x:Key="CheckBox.Normal.Background" Color="#2A2A2E" />
        <SolidColorBrush x:Key="CheckBox.Hover.Border" Color="#888888" />
        <SolidColorBrush x:Key="CheckBox.Checked.Border" Color="#4E7FFF" />
        <SolidColorBrush x:Key="CheckBox.Disabled.Border" Color="#333333" />
        <SolidColorBrush x:Key="CheckBox.Disabled.Background" Color="#1E1E20" />
        <SolidColorBrush x:Key="CheckBox.Foreground" Color="#E0E0E0" />

        <Style x:Key="ModernDarkCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource CheckBox.Foreground}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <!-- チェックボックス外枠 -->
                            <Border
                                x:Name="BoxBorder"
                                Width="20"
                                Height="20"
                                Background="{StaticResource CheckBox.Normal.Background}"
                                BorderBrush="{StaticResource CheckBox.Normal.Border}"
                                BorderThickness="2"
                                CornerRadius="6">

                                <!-- チェックマーク（PackIcon） -->
                                <materialDesign:PackIcon
                                    x:Name="CheckIcon"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FFFFFF"
                                    Kind="CheckBold"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.3" ScaleY="0.3" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Border>

                        </StackPanel>

                        <!-- トリガー & アニメーション -->
                        <ControlTemplate.Triggers>
                            <!-- ホバー時 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource CheckBox.Hover.Border}" />
                            </Trigger>

                            <!-- チェック時（アニメーション付き） -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource CheckBox.Checked.Border}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="BoxBorder"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#4E7FFF"
                                                Duration="0:0:0.15" />

                                            <ThicknessAnimation
                                                Storyboard.TargetName="BoxBorder"
                                                Storyboard.TargetProperty="BorderThickness"
                                                To="0"
                                                Duration="0:0:0.15" />

                                            <!-- フェードイン -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1.0"
                                                Duration="0:0:0.15" />
                                            <!-- スケールアップ（ぽわんと出るバウンス効果） -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                From="0.3"
                                                To="1.0"
                                                Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.3"
                                                To="1.0"
                                                Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="BoxBorder"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#2A2A2E"
                                                Duration="0:0:0.15" />

                                            <ThicknessAnimation
                                                Storyboard.TargetName="BoxBorder"
                                                Storyboard.TargetProperty="BorderThickness"
                                                To="2"
                                                Duration="0:0:0.15" />

                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.0"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="0.3"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.3"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 無効化時 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{StaticResource CheckBox.Disabled.Background}" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource CheckBox.Disabled.Border}" />
                                <Setter Property="Foreground" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- コントロール本体 -->
    <CheckBox
        Command="{Binding ElementName=Root, Path=Command}"
        CommandParameter="{Binding ElementName=Root, Path=CommandParameter}"
        IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=UserControl}}"
        Style="{StaticResource ModernDarkCheckBoxStyle}" />
</UserControl>